[Unit]
Description=wisp console
Documentation=https://github.com/willysnow/wisp
After=network-online.target
Wants=network-online.target

# In [Unit], not [Service] — systemd moved these in v230.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
ExecStart=/usr/local/bin/wisp-console \
    -addr :8000 \
    -db /var/lib/wisp-console/wisp-console.db \
    -config /etc/wisp-console/console.yaml
Restart=on-failure
RestartSec=5s

User=wisp-console
Group=wisp-console

# systemd creates and owns these.
#   /var/lib/wisp-console  database, operator accounts, certificates, ACME cache
#   /etc/wisp-console      the configuration, which the service only reads
StateDirectory=wisp-console
ConfigurationDirectory=wisp-console
WorkingDirectory=/var/lib/wisp-console

# --- Sandboxing -----------------------------------------------------------
#
# The console is not exposed to attackers the way a sensor is, but it holds
# every credential, prompt, and token the fleet has captured. It is the more
# valuable of the two to compromise.

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
# Uncomment both to serve on 443 directly — needed for ACME's TLS-ALPN-01, or
# for HTTP-01 on port 80:
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# AmbientCapabilities=CAP_NET_BIND_SERVICE

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateUsers=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
MemoryDenyWriteExecute=true

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# PrivateTmp gives SQLite somewhere to write the temporary file it needs when
# the retention janitor rebuilds the database. Without a writable /tmp that
# rebuild fails, and "old events are deleted but the disk still fills up" is
# not a fix anyone would accept.

LimitNOFILE=8192
TasksMax=512

[Install]
WantedBy=multi-user.target
